{
  "name": "fabrictear",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p tsconfig.node.json && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "gpu:render": "node tools/gpu/run.mjs tools/gpu/scripts/render.ts",
    "gpu:drape": "node tools/gpu/run.mjs tools/gpu/scripts/drape.ts",
    "test:gpu": "node tools/gpu/run.mjs tests/gpu/correctness.ts && node tools/gpu/run.mjs tests/gpu/interaction.ts && node tools/gpu/run.mjs tests/gpu/detached.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@webgpu/types": "^0.1.74",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "webgpu": "^0.6.1"
  }
}
